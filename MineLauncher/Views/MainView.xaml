<UserControl x:Class="MineLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: MainViewModel (инжектится через DI в App.xaml.cs) -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- аккаунт -->
            <RowDefinition Height="*"/>     <!-- выбор сборки/версии/загрузчика -->
            <RowDefinition Height="Auto"/>  <!-- прогресс + кнопка "Играть" -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Верхняя панель: аккаунт ===================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}"
                Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding SkinPreviewUrl}" Width="32" Height="32"/>
                <TextBlock Text="{Binding AccountStatus}" VerticalAlignment="Center" Margin="8,0"/>
                <ComboBox SelectedIndex="{Binding AuthModeIndex}" Width="150">
                    <ComboBoxItem Content="Online (Microsoft)"/>
                    <ComboBoxItem Content="Offline"/>
                </ComboBox>
                <TextBox Text="{Binding OfflineNickname}"
                         Tag="Ник (offline)" Width="140" Margin="8,0"/>
                <Button Content="Войти" Command="{Binding LoginCommand}"/>
            </StackPanel>
        </Border>

        <!-- ============ Центр слева: список сборок (instances) ============ -->
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance}" Margin="0,0,12,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MinecraftVersion}" FontSize="11" Opacity=".6"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============ Центр справа: версия / загрузчик / Java ============ -->
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Версия Minecraft" Style="{StaticResource CaptionStyle}"/>
            <ComboBox ItemsSource="{Binding MinecraftVersions}"
                      SelectedItem="{Binding SelectedVersion}" Margin="0,2,0,10"/>

            <TextBlock Text="Загрузчик модов" Style="{StaticResource CaptionStyle}"/>
            <ComboBox ItemsSource="{Binding LoaderTypes}"
                      SelectedItem="{Binding SelectedLoader}" Margin="0,2,0,10"/>

            <TextBlock Text="Версия загрузчика" Style="{StaticResource CaptionStyle}"/>
            <ComboBox ItemsSource="{Binding LoaderVersions}"
                      SelectedItem="{Binding SelectedLoaderVersion}" Margin="0,2,0,10"/>

            <!-- Индикатор Java: пересчитывается автоматически при смене версии.
                 Если IsJavaMissing=true — при запуске JavaManager скачает JRE
                 в изолированную папку runtime/jre-{version}. -->
            <Border Background="#33FF9800" CornerRadius="6" Padding="10"
                    Visibility="{Binding IsJavaMissing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding RequiredJavaLabel, StringFormat='{}{0} не найдена — будет скачана автоматически'}"/>
            </Border>
            <TextBlock Text="{Binding RequiredJavaLabel}" Opacity=".7"/>
        </StackPanel>

        <!-- ===================== Низ: прогресс + кнопка Играть ================= -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" Value="{Binding ProgressValue}"
                         Height="4" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ProgressText}"
                       VerticalAlignment="Center"/>
            <Button Grid.Row="1" Grid.Column="1" Content="ИГРАТЬ"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding LaunchGameCommand}"/>
        </Grid>
    </Grid>
</UserControl>
